{
  "execution_order": [
    "TransactionFilter",
    "InvoiceFilter",
    "LocationFilter",
    "SkuTrim",
    "AccountCodeMapper",
    "DefaultInjector",
    "ColumnMapper"
  ],
  "TransactionFilter": {
    "enabled": true,
    "allowed": [
      "Shipment"
    ]
  },
  "InvoiceFilter": {
    "enabled": true,
    "prefixes": [
      "in"
    ],
    "strip_prefix": true
  },
  "SkuTrim": {
    "enabled": true,
    "length": 6
  },
  "LocationFilter": {
    "enabled": true,
    "allowed_states": [
      "Chandigarh"
    ],
    "filter_column": "Bill From State"
  },
  "DefaultInjector": {
    "enabled": true,
    "defaults": {
      "MEM SHIP": "JH",
      "TAX REGION": 2
    }
  },
  "AccountCodeMapper": {
    "enabled": true,
    "gst_lookup_source": "GSTIN_FIRST_TWO_DIGITS"
  },
  "ColumnMapper": {
    "enabled": true
  },
  "ExactInvoiceFilter": {
    "enabled": false
  }
}